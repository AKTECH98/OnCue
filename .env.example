# OnCue environment configuration.
# Copy to .env  ->  cp .env.example .env
# Only the server reads this file. Nothing here is bundled into the browser.

# ---------------------------------------------------------------------------
# Ports (uncommon defaults so they do not collide with other local projects)
# ---------------------------------------------------------------------------
PORT=43128
CLIENT_PORT=43127

# ---------------------------------------------------------------------------
# Higgs Realtime  (Phase 4+)
# Leave HIGGS_API_KEY empty to run in simulated voice mode: the app is fully
# usable, Higgs-dependent panels show "simulated" instead of "connected".
# ---------------------------------------------------------------------------
HIGGS_API_KEY=
HIGGS_REALTIME_URL=wss://api.higgsfield.ai/v1/realtime
HIGGS_MODEL=higgs-realtime
HIGGS_VOICE=broadcast

# ---------------------------------------------------------------------------
# LangSmith tracing  (Phase 0 smoke test + Phase 3 orchestration traces)
# Tracing is optional. With no key, traces are written to the local
# in-memory trace buffer exposed at GET /api/traces.
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=oncue
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
